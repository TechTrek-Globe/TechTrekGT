{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "techtrek-outpost",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "techtrekgt.com/outpost",
      "zone_name": "techtrekgt.com"
    },
    {
      "pattern": "techtrekgt.com/outpost/*",
      "zone_name": "techtrekgt.com"
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "personal-budget-db",
      "database_id": "10f220d4-1c10-49e9-b63e-5d4cb08d599f"
    }
  ],
  "kv_namespaces": [
    // {
    //   "binding": "RATE_LIMIT_KV",
    //   "id": "<YOUR_KV_NAMESPACE_ID_HERE>",
    //   "comment": "Run `npx wrangler kv:namespace create RATE_LIMIT_KV` and paste the ID above"
    // }
  ]
}
