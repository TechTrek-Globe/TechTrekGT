{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "techtrek-budget",
  "compatibility_date": "2026-07-31",
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "personal-budget-db",
      "database_id": "local-db-id"
    }
  ]
}
