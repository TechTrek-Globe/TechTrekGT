{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "techtrek-wayfinder",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "techtrekgt.com/wayfinder",
      "zone_name": "techtrekgt.com"
    },
    {
      "pattern": "techtrekgt.com/wayfinder/*",
      "zone_name": "techtrekgt.com"
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Shared D1 database - same users as Finance, Outpost, Bigworm
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "personal-budget-db",
      "database_id": "10f220d4-1c10-49e9-b63e-5d4cb08d599f"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT_KV",
      "id": "12e45afc7ced4359949d1c1ae5537ec8"
    }
  ],
  // Cloudflare Email Routing - receives inbound forwarded emails
  // Configure catch-all or address rule pointing to this worker in Cloudflare dashboard
  "send_email": [
    {
      "name": "SEND_EMAIL"
    }
  ],
  "vars": {
    "MAIL_FROM": "noreply@techtrekgt.com"
  }
  // R2 bucket (required for document storage - not yet configured):
  // "r2_buckets": [
  //   {
  //     "binding": "WAYFINDER_BUCKET",
  //     "bucket_name": "techtrek-wayfinder-docs"
  //   }
  // ]
  // Secrets (set via `wrangler secret put`):
  //   JWT_SECRET             - same value as Finance/Outpost/Bigworm for SSO
  //   TOKEN_ENCRYPTION_KEY   - AES-256-GCM key for encrypting Gmail OAuth tokens in D1
  //   GOOGLE_CLIENT_ID       - Google Cloud OAuth 2.0 client ID (gmail.readonly scope)
  //   GOOGLE_CLIENT_SECRET   - Google Cloud OAuth 2.0 client secret
}
