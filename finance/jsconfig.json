{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "checkJs": true,
    "strict": false,
    "noImplicitAny": false,
    "noEmit": true
  },
  "include": ["src/utils/**/*"],
  "exclude": ["node_modules", "dist", "tests", "scripts"]
}
