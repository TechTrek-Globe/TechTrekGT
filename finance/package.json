{
  "name": "personal-budget-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-safe-serialization.js && vite build",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "check:serialization": "node scripts/check-safe-serialization.js",
    "lint": "npx eslint src",
    "lint:quiet": "npx eslint src --quiet",
    "typecheck": "npx tsc -p jsconfig.json",
    "test": "node scripts/check-safe-serialization.js && node --test tests/crit-*.test.js tests/phase2-*.test.js tests/security-hardening.test.js tests/calculation-engine.test.js tests/auth-offline-rejection.test.js tests/user-scoping.test.js tests/restore-round-trip.test.js tests/effective-dueday.test.js tests/tier-b-characterization.test.js tests/tier-c-fixes.test.js tests/med-*.test.js tests/low-*.test.js tests/audit-*.test.js",
    "test:e2e": "node --test tests/live-e2e.test.js"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.50.0",
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^7.0.2",
    "vite": "^6.0.7",
    "wrangler": "^4.118.0"
  }
}
